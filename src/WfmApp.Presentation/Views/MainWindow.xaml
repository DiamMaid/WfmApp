<Window x:Class="WfmApp.Presentation.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:WfmApp.Presentation.Converters"
        Title="Ozon WFM — Дашборд руководителя склада" Height="760" Width="1150"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <conv:AttendanceToBrushConverter x:Key="AttendanceBrush"/>
    </Window.Resources>

    <DockPanel Margin="12">
        <Border DockPanel.Dock="Top" Padding="10,8" Background="#F2F4F7" CornerRadius="4">
            <WrapPanel VerticalAlignment="Center">
                <TextBlock Text="Логистический хаб" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <ComboBox Width="230" ItemsSource="{Binding Hubs}" SelectedItem="{Binding SelectedHub}"
                          DisplayMemberPath="DisplayName" Margin="0,0,20,0"/>
                <TextBlock Text="Производственная зона" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <ComboBox Width="160" ItemsSource="{Binding Zones}" SelectedItem="{Binding SelectedZone}" Margin="0,0,20,0"/>
                <TextBlock Text="Дата смены" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <DatePicker Width="140" SelectedDate="{Binding SelectedDate}" Margin="0,0,20,0"/>
                <Button Content="Обновить" Command="{Binding ReloadCommand}" Padding="14,5"/>
            </WrapPanel>
        </Border>

        <Border DockPanel.Dock="Top" Padding="10,8" Margin="0,8,0,0" Background="#FBFBFB"
                BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="4">
            <WrapPanel VerticalAlignment="Center">
                <TextBlock Text="Сотрудник" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <ComboBox Width="300" ItemsSource="{Binding Employees}" SelectedItem="{Binding SelectedEmployee}"
                          DisplayMemberPath="DisplayName" IsEditable="True" IsTextSearchEnabled="True"
                          StaysOpenOnEdit="True" Margin="0,0,20,0"/>
                <CheckBox Content="Ночная смена (20:00–08:00), иначе дневная (08:00–20:00)"
                          IsChecked="{Binding IsNightPreset}" VerticalAlignment="Center" Margin="0,0,20,0"/>
                <Button Content="Назначить на смену" Command="{Binding AssignCommand}" Padding="14,5"/>
            </WrapPanel>
        </Border>

        <Border DockPanel.Dock="Bottom" Padding="10,8" Margin="0,8,0,0" Background="#F2F4F7" CornerRadius="4">
            <WrapPanel VerticalAlignment="Center">
                <TextBlock FontSize="14" Margin="0,0,28,0">
                    <Run Text="Всего на смене: " FontWeight="SemiBold"/>
                    <Run Text="{Binding TotalOnShift, Mode=OneWay}" FontWeight="Bold"/>
                    <Run Text=" чел."/>
                </TextBlock>
                <TextBlock FontSize="14" Margin="0,0,28,0">
                    <Run Text="В зоне приёмки: " FontWeight="SemiBold"/>
                    <Run Text="{Binding ReceivingCount, Mode=OneWay}" FontWeight="Bold"/>
                </TextBlock>
                <TextBlock FontSize="14" Margin="0,0,28,0">
                    <Run Text="В зоне упаковки: " FontWeight="SemiBold"/>
                    <Run Text="{Binding PackingCount, Mode=OneWay}" FontWeight="Bold"/>
                </TextBlock>
                <TextBlock FontSize="14" Foreground="#2E7D32" Text="{Binding DbStatusText}"/>
                <TextBlock FontSize="14" Foreground="#C62828" Margin="28,0,0,0" Text="{Binding ErrorMessage}"/>
                <TextBlock FontSize="14" Foreground="#2E7D32" Margin="28,0,0,0" Text="{Binding StatusMessage}"/>
            </WrapPanel>
        </Border>

        <DataGrid ItemsSource="{Binding Shifts}" AutoGenerateColumns="False" IsReadOnly="True"
                  Margin="0,8,0,0" CanUserAddRows="False" SelectionMode="Single"
                  GridLinesVisibility="Horizontal" HeadersVisibility="Column">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Табельный" Binding="{Binding StaffId}" Width="90"/>
                <DataGridTextColumn Header="ФИО сотрудника" Binding="{Binding FullName}" Width="220"/>
                <DataGridTextColumn Header="Роль" Binding="{Binding Role}" Width="120"/>
                <DataGridTextColumn Header="Зона работы" Binding="{Binding Zone}" Width="110"/>
                <DataGridTextColumn Header="Начало" Binding="{Binding Start, StringFormat={}{0:dd.MM HH:mm}}" Width="90"/>
                <DataGridTextColumn Header="Конец" Binding="{Binding End, StringFormat={}{0:dd.MM HH:mm}}" Width="90"/>
                <DataGridTemplateColumn Header="Статус явки" Width="120">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding AttendanceText}" FontWeight="Bold"
                                       Foreground="{Binding Attendance, Converter={StaticResource AttendanceBrush}}"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="Действия" Width="220">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <Button Content="Check-in" Command="{Binding CheckInCommand}"
                                        IsEnabled="{Binding CanCheckIn}" Padding="8,3" Margin="0,0,6,0"/>
                                <Button Content="Check-out" Command="{Binding CheckOutCommand}"
                                        IsEnabled="{Binding CanCheckOut}" Padding="8,3"/>
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</Window>
