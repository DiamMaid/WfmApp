<Window x:Class="WfmApp.Presentation.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Планирование смен" Height="360" Width="440"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="130"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="EmployeeId (GUID)" VerticalAlignment="Center" Margin="4"/>
        <TextBox Grid.Column="1" Margin="4"
                 Text="{Binding EmployeeIdInput, UpdateSourceTrigger=PropertyChanged}"/>

        <TextBlock Grid.Row="1" Text="Начало смены" VerticalAlignment="Center" Margin="4"/>
        <TextBox Grid.Row="1" Grid.Column="1" Margin="4"
                 Text="{Binding Start, UpdateSourceTrigger=PropertyChanged, StringFormat={}{0:yyyy-MM-dd HH:mm}}"/>

        <TextBlock Grid.Row="2" Text="Конец смены" VerticalAlignment="Center" Margin="4"/>
        <TextBox Grid.Row="2" Grid.Column="1" Margin="4"
                 Text="{Binding End, UpdateSourceTrigger=PropertyChanged, StringFormat={}{0:yyyy-MM-dd HH:mm}}"/>

        <TextBlock Grid.Row="3" Grid.ColumnSpan="2" Margin="4,8,4,0" TextWrapping="Wrap"
                   Foreground="#C62828" Text="{Binding ErrorMessage}"/>

        <TextBlock Grid.Row="4" Grid.ColumnSpan="2" Margin="4" TextWrapping="Wrap"
                   Foreground="#2E7D32" Text="{Binding StatusMessage}"/>

        <Button Grid.Row="5" Grid.ColumnSpan="2" Margin="4,12,4,4" Padding="0,6"
                Content="Создать смену" Command="{Binding SaveCommand}"/>
    </Grid>
</Window>